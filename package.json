{
  "name": "projeto-nexo-governamental",
  "version": "1.0.0",
  "description": "Site institucional e painel editorial do Nexo Governamental XI de Agosto",
  "main": "./server/index.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.cjs",
    "dev:web": "webpack serve --mode development",
    "build": "webpack --mode production",
    "start": "node --env-file-if-exists=.env server/index.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "backup": "node --env-file-if-exists=.env scripts/backup.cjs",
    "restore:backup": "node --env-file-if-exists=.env scripts/restore.cjs",
    "check:readiness": "node --env-file-if-exists=.env scripts/readiness.cjs",
    "content:institutional": "node --env-file-if-exists=.env scripts/update-institutional.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-loader": "^9.2.1",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "fastify": "^5.12.3",
    "lucide-react": "^1.42.0",
    "markdown-it": "^14.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
