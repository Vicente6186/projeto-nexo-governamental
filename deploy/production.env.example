# Copie para .env.production na raiz. Não versionar a cópia preenchida.
# Ambiente e prévia também são fixados pelo Compose, independentemente deste arquivo.
NODE_ENV=production
CMS_LOCAL_PREVIEW=0
HOST=0.0.0.0
PORT=3001
DATA_DIR=/app/data

# Preencha a origem HTTPS exata após escolher o domínio. Sem barra final.
CMS_ORIGIN=
ADMIN_NAME=Vicente
ADMIN_EMAIL=vicentechemin@gmail.com
# Senha exclusiva com pelo menos 12 caracteres. Não há senha padrão.
ADMIN_PASSWORD=

# Somente IPs/CIDRs exatos do proxy reverso usado; vazio para conexão direta.
# No Compose, confirme o endereço que realmente alcança o contêiner antes de preencher.
CMS_TRUST_PROXY=

# Backups privados no volume, com primeira cópia após 60 s de execução.
CMS_BACKUP_DIR=/app/data/backups
CMS_BACKUP_INTERVAL_HOURS=24
CMS_BACKUP_KEEP=14

# Porta no HOST do Compose, vinculada exclusivamente a 127.0.0.1.
NEXO_HTTP_PORT=3001
