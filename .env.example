# Node.js 24+. Copie para .env e preencha apenas no ambiente de destino.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data

# URL exata que o navegador usa, sem barra final. Produção exige HTTPS.
CMS_ORIGIN=http://localhost:8080
ADMIN_NAME=Equipe Nexo
ADMIN_EMAIL=
# Use uma senha exclusiva com pelo menos 12 caracteres. Nunca faça commit da senha.
ADMIN_PASSWORD=

# Exclusivo da demonstração neste computador. Mantenha 0 em produção.
CMS_LOCAL_PREVIEW=0
