# Node.js 24+. Copie para .env e preencha apenas no ambiente de destino.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data

# URL exata que o navegador usa, sem barra final. Produção exige HTTPS.
CMS_ORIGIN=http://127.0.0.1:8080
ADMIN_NAME=Vicente
ADMIN_EMAIL=vicentechemin@gmail.com
# Use uma senha exclusiva com pelo menos 12 caracteres. Nunca faça commit da senha.
ADMIN_PASSWORD=

# Acesso sem senha desativado. Mantenha 0 para o uso normal e em produção.
CMS_LOCAL_PREVIEW=0

# Confie somente no IP/CIDR exato do proxy reverso da hospedagem.
# Vazio = acesso direto. Exemplo de proxy no mesmo servidor: 127.0.0.1,::1
# Nunca use true, *, 0.0.0.0/0 ou ::/0.
CMS_TRUST_PROXY=

# Backups automáticos somente em produção. Primeiro após 60 s; depois a cada 24 h.
# Destino vazio = DATA_DIR/backups, dentro do volume persistente.
# Uma cópia fora do servidor deve ser preparada separadamente.
CMS_BACKUP_DIR=
# Entre 1 e 168 horas; 0 desativa (exige agendamento externo para produção).
CMS_BACKUP_INTERVAL_HOURS=24
# Número de backups automáticos/manuais a reter neste destino.
CMS_BACKUP_KEEP=14
